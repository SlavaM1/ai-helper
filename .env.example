# Copy only variable names you need into a local .env. Never commit real keys.
DEEPSEEK_API_KEY=replace-with-your-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEFAULT_MODEL=deepseek-flash

# Linux/WSL host path to the real target repository mounted read-only.
TARGET_REPO_HOST_PATH=../aurelSpa
AI_HELPER_AUTO_INDEX=true

# Optional when the default localhost ports are already occupied.
FRONTEND_PORT=3000
BACKEND_PORT=8000
